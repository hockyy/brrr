# Facts drive a pass. fold-reshape composes reshape(reshape(x)), then drops a
# reshape whose source already has the target type — which here is only true
# because the module facts make src_size and dst_size the same number.
#
#   brrr run src/examples/reshape_facts.br --passes=fold-reshape
#   -> @reshape_chain returns %x directly
#
# Change `fact dst_size = 512` to 1024 and `check` rejects the second reshape
# before any pass runs: `element count: 8 * 64 == dst_size is false`.
fact src_size = 512
fact dst_size = 512

func @reshape_chain(%x: tensor<[src_size], f16>) -> tensor<[dst_size], f16> {
  %r1 = reshape %x : tensor<[8, 64], f16>
  %r2 = reshape %r1 : tensor<[dst_size], f16>
  return %r2
}
