# Mapping of the HIVM-lowered matmul from AscendNPU-IR:
#   bishengir/test/Conversion/HFusionToHIVM/matmul.mlir :: @test_MmadL1_real_init
#
# MLIR's memref<16x16xf32> is memref<[16, 16], f32> here: the same information,
# with dimensions as expressions, so `16` could as well be `%n` or `2 * tile`.
# HIVM and bufferization ops are foreign vocabulary; their configuration is
# plain attributes.
func @test_MmadL1_real_init(%c: memref<[16, 16], f32>) -> tensor<[16, 16], f32> {
  %mc = bufferization.to_tensor %c restrict=true writable=true : tensor<[16, 16], f32>
  %ma = memref.alloc : memref<[16, 16], f16>
  %ta = bufferization.to_tensor %ma restrict=true writable=true : tensor<[16, 16], f16>
  %mb = memref.alloc : memref<[16, 16], f16>
  %tb = bufferization.to_tensor %mb restrict=true writable=true : tensor<[16, 16], f16>
  %ret = hivm.hir.mmadL1 %ta, %tb, %mc init=false core=aic : tensor<[16, 16], f32>
  return %ret
}
