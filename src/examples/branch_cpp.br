# C++-shaped if/else sugar: lowered to `cbr` + branch blocks + `edge`s + a join
# block that carries the node id/name (so `pick` is the join's value).
func @pick_max(n1) {
  n2 = param idx=0 type="i64"
  n3 = param idx=1 type="i64"
  n4 greater = icmp n2 n3 pred="gt"

  n5 pick = if (greater) {
    fact n2 >= n3
    n6 = yield n2
  } else {
    fact n2 <= n3
    n7 = yield n3
  }

  n8 = func.return pick
}
