# Mapping of: clang++ -O1 -S -emit-llvm on
#   float dot(const float* a, const float* b, int n);
#
# Blocks take arguments; each branch passes the values its target needs. Where
# LLVM writes phi pairs (value, predecessor), the values sit at the branch sites
# instead: no predecessor labels, nothing to keep in sync when the CFG changes.
# LLVM-specific ops (llvm.*) are foreign vocabulary: accepted, reported, unchecked.
func @dot(%a: ptr, %b: ptr, %n: i32) -> f32 {
  %zero_i32 = const 0 : i32
  %zero_f32 = const 0.0 : f32
  %cond = icmp %n, %zero_i32 pred=gt
  cond_br %cond, ^header, ^exit(%zero_f32)            # was: phi [0.0, %entry] in exit
^header:
  %span = llvm.zext %n : i64
  %zero_i64 = const 0 : i64
  br ^body(%zero_i64, %zero_f32)                      # was: phi [0, %header], [0.0, %header]
^body(%i: i64, %acc: f32):
  %next = add %i, 1 nsw=true
  %pa = llvm.gep %a, %i elem=f32 : ptr
  %va = llvm.load %pa align=4 : f32
  %pb = llvm.gep %b, %i elem=f32 : ptr
  %vb = llvm.load %pb align=4 : f32
  %fma = llvm.fmuladd %va, %vb, %acc : f32
  %done = icmp %next, %span pred=eq
  cond_br %done, ^exit(%fma), ^body(%next, %fma)      # was: phi [%fma, %body], [%next, %body]
^exit(%r: f32):
  return %r
}
