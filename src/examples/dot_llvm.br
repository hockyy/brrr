# Mapping of: clang++ -O1 -S -emit-llvm on
#   float dot(const float* a, const float* b, int n);
# Blocks are scopes; br/cbr are declared; phi lists (value, from-block) pairs.
# Cross-block values use stable ids (e.g. n25 below); names stay scope-local.
func @dot(n1) {
  n2 p0 = param idx=0 type="ptr<float>"
  n3 p1 = param idx=1 type="ptr<float>"
  n4 n = param idx=2 type="i32"
  n5 zero_i32 = arith.constant type="i32" value="0"
  n6 zero_f32 = arith.constant type="f32" value="0.0"
  n7 one = arith.constant type="i64" value="1"

  n8 entry = block {
    n9 cond = icmp n zero_i32 pred="sgt"
    n10 = cbr cond header exit
  }

  n11 header = block {
    n12 span = zext n type="i64"
    n13 = br body
  }

  n14 exit = block {
    n15 res = phi zero_f32 entry n25 body
    n16 = func.return res
  }

  n17 body = block {
    n18 idx = phi zero_i32 header next body
    n19 acc = phi zero_f32 header fma body
    n20 next = arith.addi idx one
    n21 ap0 = gep p0 idx elem="float"
    n22 av0 = llvm.load n21 align=4
    n23 ap1 = gep p1 idx elem="float"
    n24 av1 = llvm.load n23 align=4
    n25 fma = llvm.fmuladd av0 av1 acc
    n26 done = icmp next n12 pred="eq"
    n27 = cbr done exit body
  }
}
