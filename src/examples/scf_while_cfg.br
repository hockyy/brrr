# CFG lowering of MLIR's two-region scf.while:
#
#   %res = scf.while (%arg0 = %init) : (i64) -> (i64) {
#     %cond = arith.cmpi slt, %arg0, %bound : i64
#     scf.condition(%cond) %arg0 : i64
#   } do {
#   ^bb0(%v: i64):
#     %next = arith.addi %v, %step : i64
#     scf.yield %next : i64
#   }
#
# The two regions become a three-block cycle:
#   * ^before is the loop header; its argument %arg0 IS the iter_arg.
#   * scf.condition(%cond) %arg0 is one cond_br whose two successors both carry %arg0.
#   * scf.yield %next is not a result: it is the back edge `br ^before(%next)`.
#   * the while's result is whatever the false successor carried out.
func @scf_while_cfg(%init: i64, %bound: i64, %step: i64) -> i64 {
  br ^before(%init)
^before(%arg0: i64):
  %cond = icmp %arg0, %bound pred=lt
  cond_br %cond, ^after(%arg0), ^exit(%arg0)
^after(%v: i64):
  %next = add %v, %step
  br ^before(%next)
^exit(%r: i64):
  return %r
}
