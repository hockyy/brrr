# Modules: the top-level unit and symbol root.
module @kernels(n1) {
  func @reshape_chain(n2) {
    n3 x = load dtype=@f16 shape="src_size"
    n4 r1 = reshape x in="src_size" out="mid"
    n5 r2 = reshape r1 in="mid" out="dst_size"
    n6 = func.return r2
  }

  func @pass_through(n7) {
    n8 y = load dtype=@f16 shape="src_size"
    n9 = func.return y
  }
}
