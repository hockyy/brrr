# 03 — Vocabulary is schema data, not C++. `brrr schema` prints it.
#
#   brrr schema
#   brrr check src/showcase/03_vocabulary.br
#
# `icmp`'s `pred` is declared `enum(eq|ne|lt|le|gt|ge)`: change pred=gt to
# pred=gtt and `check` names the allowed values. A kind no schema declares is
# foreign vocabulary: accepted, reported once as a warning, never silently checked.
func @pick(%a: i32, %b: i32) -> i32 {
  %c = icmp %a, %b pred=gt
  %m = select %c, %a, %b
  %w = mytarget.tune %m tile=[32, 32] mode=fast    # foreign: a warning, not an error
  return %m
}
