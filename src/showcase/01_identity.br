# 01 — Identity. Every definition has a stable id; names are for reading.
#
#   brrr print  src/showcase/01_identity.br           # clean form (default)
#   brrr print  src/showcase/01_identity.br --ids     # stored form: ids shown
#   brrr rename src/showcase/01_identity.br %sum %total
#
# An unnamed value prints as its id (%5 below), so even the clean form keeps
# identity. Ids are not positions: %5 is the first id the text fixes, and the
# rest are allocated above it.
func @scale(%x: tensor<[128], f16>, %y: tensor<[128], f16>) -> tensor<[128], f16> {
  %sum = add %x, %y
  %5 = relu %sum
  return %5
}
