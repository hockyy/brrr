# 02 — Facts and invariants. Facts are scoped: they hold where they are written
# and flow inward through the scope chain; queries are tri-state and honest.
#
#   bridgeir facts src/showcase/02_invariants.br
#   bridgeir ask   src/showcase/02_invariants.br root  "aligned(n, 16)"  -> Yes
#   bridgeir ask   src/showcase/02_invariants.br count "0 <= i"          -> Yes
#   bridgeir ask   src/showcase/02_invariants.br count "i <= n"          -> Yes
#   bridgeir ask   src/showcase/02_invariants.br root  "0 <= i"          -> Unknown
fact n = 512
fact aligned(n, 16)

func @countdown(n1) {
  n2 n_val = param idx=0 type="i64"
  n3 zero = arith.constant type="i64" value="0"
  n4 neg = arith.constant type="i64" value="-1"

  n5 count = loop n_val {
    n6 i = param idx=0
    fact 0 <= i
    fact i <= n_val
    n7 next = arith.addi i neg
    n8 more = icmp next zero pred="gt"
    n9 = loop.yield more next
  }

  n10 = func.return count
}
