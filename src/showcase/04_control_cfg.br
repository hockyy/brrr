# 04 — Control flow, canonical form. Blocks are scopes that take parameters;
# `edge` values deliver the branch payloads; the join block's parameters are the
# merged values. Only sanctioned roads cross scopes (terminator -> edge, edge ->
# its target, phi -> predecessor values); everything else is dominance-checked.
#
#   bridgeir print   src/showcase/04_control_cfg.br
#   bridgeir ask     src/showcase/04_control_cfg.br then "a >= b"   -> Yes
#   bridgeir print --c-like src/showcase/04_control_cfg.br
func @pick_max(n1) {
  n2 a = param idx=0 type="i64"
  n3 b = param idx=1 type="i64"
  n4 gt = icmp a b pred="gt"

  n5 then = block {
    fact a >= b
    n6 e_then = edge join a
  }

  n7 else = block {
    fact a <= b
    n8 e_else = edge join b
  }

  n9 join = block {
    n10 res = param idx=0
  }

  n11 = cbr gt n6 n8
  n12 = func.return join
}
