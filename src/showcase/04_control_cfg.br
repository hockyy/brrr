# 04 — Control flow, canonical form. Blocks are scopes that take parameters;
# `edge` values deliver the branch payloads; the join block's parameters are the
# merged values. Only sanctioned roads cross scopes (terminator -> block/edge,
# edge -> its target); everything else is dominance-checked. There is no phi.
#
#   bridgeir print   src/showcase/04_control_cfg.br
#   bridgeir ask     src/showcase/04_control_cfg.br then "a >= b"   -> Yes
#   bridgeir print --c-like src/showcase/04_control_cfg.br
func @pick_max(n1) {
  n2 = param idx=0 type="i64"
  n3 = param idx=1 type="i64"
  n4 gt = icmp n2 n3 pred="gt"

  n5 then = block {
    fact n2 >= n3
    n6 e_then = edge join n2
  }

  n7 else = block {
    fact n2 <= n3
    n8 e_else = edge join n3
  }

  n9 join = block {
    n10 = param idx=0
  }

  n11 = cbr gt n6 n8
  n12 = func.return join
}
