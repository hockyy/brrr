# 05 — Structured loops. The loop is a scope: carried values are its parameters,
# `loop.yield` supplies (continue-condition, next values), and `loop.N` ports are
# the exit values. Invariants live in the body and answer queries there.
#
#   bridgeir print src/showcase/05_control_structured.br
#   bridgeir ask   src/showcase/05_control_structured.br sum "i <= n"   -> Yes
#   bridgeir ask   src/showcase/05_control_structured.br root "i <= n"  -> Unknown
func @sum_to_n(n1) {
  n2 = param idx=0 type="i64"
  n3 zero = arith.constant type="i64" value="0"
  n4 one = arith.constant type="i64" value="1"

  n5 sum = loop zero n2 {
    n6 = param idx=0
    n7 = param idx=1
    fact 0 <= n7
    fact n7 <= n2
    n8 next_i = arith.addi n7 one
    n9 new_acc = arith.addi n6 n7
    n10 more = icmp next_i n2 pred="slt"
    n11 = loop.yield more new_acc next_i
  }

  n12 = func.return sum.1
}
