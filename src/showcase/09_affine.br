# 09 — Division and the MLIR affine bridge.
#
# `floordiv`, `ceildiv` and `mod` take a positive constant and bind like `*`,
# exactly as in MLIR affine expressions. There is no `/`: integer division has
# to say how it rounds. `apply` makes an expression a value (MLIR's affine.apply,
# without the map).
#
#   brrr ask src/showcase/09_affine.br @tiles "%n <= %count * 32"             -> Yes
#   brrr ask src/showcase/09_affine.br @tiles "0 <= %lane <= 31"             -> Yes
#   brrr ask src/showcase/09_affine.br @tiles "(4 * %n) floordiv 2 == 2 * %n" -> Yes
#
# Export: each expression lands on the right side of MLIR's OpFoldResult.
#   brrr to-affine src/showcase/09_affine.br @tiles "%mult, 4, %n * 4 + %base"
#     %mult           value, defined as affine.apply affine_map<()[s0] -> ((s0 * 2) floordiv 3)>()[%base]
#     4               static 4 (an attribute)
#     %n * 4 + %base  affine.apply affine_map<()[s0, s1] -> (s0 * 4 + s1)>()[%n, %base]
#   brrr to-affine src/showcase/09_affine.br @pinned "%mult"   -> static 4 (a fact pins %base)
#
# Import: an MLIR affine map applied to operands.
#   brrr from-affine "affine_map<(d0)[s0] -> (d0 * 4 + s0, d0 floordiv 2)>" %i %n
#     %i * 4 + %n, %i floordiv 2
func @tiles(%n: index, %base: index) -> index {
  %count = apply %n ceildiv 32          # how many 32-wide tiles cover %n
  %lane = apply %n mod 32               # position inside the last tile
  %mult = apply %base * 2 floordiv 3
  return %count
}

func @pinned(%base: index) -> index {
  fact %base = 6
  %mult = apply %base * 2 floordiv 3    # the solver folds this to 4
  return %mult
}
