# 06 — C++-shaped sugar. Headers look like C++; `bridgeir print` shows the
# canonical lowering (for/while -> loop + params + loop.yield; if/else -> cbr +
# branch blocks + edges + a join block that carries the node id/name).
#
#   bridgeir print src/showcase/06_cpp_sugar.br
#   bridgeir check src/showcase/06_cpp_sugar.br
#
# Conditions and step values are SSA value names (not expressions): the body
# computes them. `while` discovers its carried names from body assignments.
func @sum_for(n1) {
  n2 = param idx=0 type="i64"
  n3 zero = arith.constant type="i64" value="0"
  n4 one = arith.constant type="i64" value="1"

  n5 total = for (acc = zero, i = n2; more; acc = new_acc, i = next_i) {
    fact 0 <= i
    n6 next_i = arith.addi i one
    n7 new_acc = arith.addi acc i
    n8 more = icmp next_i n2 pred="slt"
  }

  n9 = func.return total
}

func @countdown_while(n10) {
  n11 zero = arith.constant type="i64" value="0"
  n12 neg = arith.constant type="i64" value="-1"
  n13 i = arith.constant type="i64" value="4"

  n14 w = while (more) {
    n15 next = arith.addi i neg
    i = next
    n16 more = icmp next zero pred="gt"
  }

  n17 = func.return w
}

func @max0(n18) {
  n19 = param idx=0 type="i64"
  n20 zero = arith.constant type="i64" value="0"
  n21 neg = icmp n19 zero pred="slt"

  n22 m = if (neg) {
    n23 = yield zero
  } else {
    n24 = yield n19
  }

  n25 = func.return m
}
