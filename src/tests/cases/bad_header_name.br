# Argument list entries are `TYPE ID`; a name would be an alias, and aliases are
# gone -- everything is an id. Declaring one is rejected.
func @bad_header_name(n1) {
  n2 zero = arith.constant type="i64" value="0"
  n3 entry = block {
    n4 e = edge body zero
    n5 = br e
  }
  n6 body = block (int64 n7 acc) {
  }
}
