# for-loop step must update every carried value (here `i` is never updated).
func @bad_for(n1) {
  n2 zero = arith.constant type="i64" value="0"
  n3 one = arith.constant type="i64" value="1"
  n4 sum = for (acc = zero, i = one; more; acc = new_acc) {
    n5 new_acc = arith.addi acc i
    n6 more = icmp new_acc zero pred="gt"
  }
  n7 = func.return sum
}
