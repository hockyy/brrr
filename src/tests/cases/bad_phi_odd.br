# Structural violation now proven generically by the declared port group:
# phi operands are `(value, block)*`, so an odd count is a schema violation.
func @bad_phi_odd(n1) {
  n2 zero = arith.constant type="i64" value="0"
  n3 entry = block {
    n4 = br exit
  }
  n5 exit = block {
    n6 res = phi zero
  }
}
