# Values cross block boundaries only through block arguments. An argument is
# declared once, in the scope header, as `TYPE ID` -- and referenced by that id.
# There is no name alias.
func @block_header_args(n1) {
  n2 zero = arith.constant type="i64" value="0"
  n3 one = arith.constant type="i64" value="1"
  n4 gt = icmp one zero pred="gt"

  n5 then = block {
    n6 e_then = edge join zero one
  }

  n7 else = block {
    n8 e_else = edge join one zero
  }

  n9 join = block (int64 n10, int64 n11) {
    n12 s = arith.addi n10 n11
  }

  n13 = cbr gt n6 n8
  n14 = func.return join
}
