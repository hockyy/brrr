# A dot product over two buffers. The loop's induction variable carries its
# range as a fact (proven on entry and on the back edge), so every load is
# proven in bounds and the compiled code needs no runtime checks.
func @dot(%n: index, %a: buf<[%n], f32>, %b: buf<[%n], f32>) -> f32 {
  fact 1 <= %n
  %zero = const 0 : index
  %fzero = const 0.0 : f32
  br ^loop(%zero, %fzero)
^loop(%i: index, %acc: f32):
  fact 0 <= %i <= %n - 1
  %x = load %a, [%i] : f32
  %y = load %b, [%i] : f32
  %p = mul %x, %y : f32
  %acc2 = add %acc, %p : f32
  %i2 = add %i, 1
  %more = icmp %i2, %n pred=lt
  cond_br %more, ^loop(%i2, %acc2), ^done(%acc2)
^done(%r: f32):
  return %r
}
